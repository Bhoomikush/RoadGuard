# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Speech-to-Text & AI Assistant (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# AI Complaint Generation (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_SITE_URL=https://roadguard.vercel.app
OPENROUTER_APP_NAME=RoadGuard

# Email Delivery (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
ROAD_AUTHORITY_EMAIL=authority-complaints@roadguard.internal

# Geocoding Configuration (Optional overrides)
GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=RoadGuard-CitizenReporting/1.0 (contact@roadguard.internal)

# Specific Authority Direct Emails (Optional overrides)
NHAI_EMAIL=
BMC_EMAIL=
PMC_EMAIL=
TMC_EMAIL=
PCMC_EMAIL=
NMMC_EMAIL=
PWD_KONKAN_EMAIL=
PWD_PUNE_EMAIL=
PWD_NASHIK_EMAIL=

# ML Model Storage & Path (YOLOv8 weights)
SUPABASE_MODEL_BUCKET=roadguard-models
SUPABASE_MODEL_PATH=best.pt
MODEL_PATH=

# CORS & Server
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
